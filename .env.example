# Meta WhatsApp Cloud API
# Usa un System User Token permanente, no el token temporal de prueba.
META_ACCESS_TOKEN=EAAG...
META_PHONE_NUMBER_ID=1234567890
META_WABA_ID=1234567890
META_APP_SECRET=abcdef...
META_VERIFY_TOKEN=elige-un-token-aleatorio
META_GRAPH_VERSION=v25.0
# URL HTTPS pública de la landing; nunca uses localhost ni una ruta relativa.
PUBLIC_APP_URL=https://tu-dominio-publico.example

# API compatible con OpenAI (OpenAI, OpenRouter u otro proveedor)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=google/gemini-2.5-flash-lite
# URL opcional del proveedor compatible. Déjala vacía para la API oficial de OpenAI.
OPENAI_BASE_URL=

# Almacenamiento privado de QR en Supabase (solo servidor)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_QR_BUCKET=chatbot-qr
SUPABASE_PAYMENT_QR_PATH=payment-qr.jpeg

# Catálogo Terra (panel privado y sitio público)
# La URL y clave pública permiten las funciones de catálogo en el navegador.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Clave simple para abrir /catalogo-admin. Cámbiala antes de publicar el sitio.
CATALOG_ADMIN_PASSWORD=admin
# Número de atención que abrirán los botones del catálogo, solo dígitos con país.
NEXT_PUBLIC_TERRA_WHATSAPP_PHONE=59178600064
# Token aleatorio compartido únicamente con el proceso que genera el QR
QR_UPLOAD_TOKEN=reemplaza-por-un-token-aleatorio-largo
# Secreto de servidor que la landing usa al confirmar un pedido
ORDER_CONFIRMATION_TOKEN=reemplaza-por-otro-token-aleatorio-largo
